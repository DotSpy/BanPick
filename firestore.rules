rules_version = '2';

// Presets are read by id only (no list queries) and edited only by the anonymous uid that created them.
// Drafts are reached by link; seats are bound to the uid that claimed them. Pick/ban legality is enforced by
// the client engine and re-checked on every snapshot (src/draft.ts verifyState), not by these rules.
service cloud.firestore {
  match /databases/{database}/documents {
    match /presets/{id} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['preset', 'ownerUid', 'createdAt', 'updatedAt'])
        && request.resource.data.preset is string
        && request.resource.data.preset.size() < 100000;
      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.preset is string
        && request.resource.data.preset.size() < 100000;
      allow delete: if false;
    }

    match /drafts/{roomId} {
      function changed() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }
      function stateKeysOnly() {
        return changed().hasOnly(['state', 'phase', 'deadline', 'turnIndex', 'updatedAt']);
      }

      allow read: if request.auth != null;
      allow create: if request.auth != null;

      allow update: if request.auth != null && (
        // Claim an empty seat in the lobby.
        (
          resource.data.phase == 'lobby' &&
          request.resource.data.phase == 'lobby' &&
          (
            (resource.data.ownerA == null &&
              request.resource.data.ownerA == request.auth.uid &&
              request.resource.data.ownerB == resource.data.ownerB &&
              changed().hasOnly(['ownerA', 'state', 'updatedAt'])) ||
            (resource.data.ownerB == null &&
              request.resource.data.ownerB == request.auth.uid &&
              request.resource.data.ownerA == resource.data.ownerA &&
              changed().hasOnly(['ownerB', 'state', 'updatedAt']))
          )
        ) ||
        // Release your own seat in the lobby.
        (
          resource.data.phase == 'lobby' &&
          request.resource.data.phase == 'lobby' &&
          (
            (resource.data.ownerA == request.auth.uid &&
              request.resource.data.ownerA == null &&
              request.resource.data.ownerB == resource.data.ownerB &&
              changed().hasOnly(['ownerA', 'state', 'updatedAt'])) ||
            (resource.data.ownerB == request.auth.uid &&
              request.resource.data.ownerB == null &&
              request.resource.data.ownerA == resource.data.ownerA &&
              changed().hasOnly(['ownerB', 'state', 'updatedAt']))
          )
        ) ||
        // Seat owners write draft state; seats cannot change here.
        (
          (resource.data.ownerA == request.auth.uid || resource.data.ownerB == request.auth.uid) &&
          request.resource.data.ownerA == resource.data.ownerA &&
          request.resource.data.ownerB == resource.data.ownerB &&
          stateKeysOnly()
        ) ||
        // Anyone may advance an overdue timer so a stalled captain cannot block the draft.
        (
          resource.data.phase == 'drafting' &&
          resource.data.deadline != null &&
          resource.data.deadline <= request.time.toMillis() &&
          request.resource.data.turnIndex >= resource.data.turnIndex &&
          (request.resource.data.turnIndex > resource.data.turnIndex || request.resource.data.deadline != resource.data.deadline) &&
          request.resource.data.ownerA == resource.data.ownerA &&
          request.resource.data.ownerB == resource.data.ownerB &&
          stateKeysOnly()
        )
      );

      allow delete: if false;
    }
  }
}
