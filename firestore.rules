rules_version = '2';

// Presets are read by id only (no list queries) and edited only by the anonymous uid that created them.
// Drafts are reached by link; seats are bound to the uid that claimed them. Rules pin the preset, the recorded history
// and each team's own writes. Pool membership and restrictions are not checkable here: the client engine enforces them
// and re-checks the whole history on every snapshot (src/draft.ts verifyState).
service cloud.firestore {
  match /databases/{database}/documents {
    // Presets are stored as one JSON string, which rules cannot parse. Beyond the size limit, the only shape check
    // possible is a text match: every item "image" value must start with https:// (the client validates the rest on load).
    function presetOk(p) {
      return p is string
        && p.size() < 100000
        && !p.matches('(?s).*"image":\\s*([^"\\s]|"([^h]|h[^t]|ht[^t]|htt[^p]|http[^s]|https[^:]|https:[^/]|https:/[^/])).*');
    }

    match /presets/{id} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['preset', 'ownerUid', 'createdAt', 'updatedAt'])
        && presetOk(request.resource.data.preset);
      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.createdAt == resource.data.createdAt
        && presetOk(request.resource.data.preset);
      allow delete: if false;
    }

    match /drafts/{roomId} {
      function changed() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }
      function ownerOf(team) {
        return team == 'A' ? resource.data.ownerA : resource.data.ownerB;
      }
      function isSeat() {
        return resource.data.ownerA == request.auth.uid || resource.data.ownerB == request.auth.uid;
      }
      function seatsSame() {
        return request.resource.data.ownerA == resource.data.ownerA && request.resource.data.ownerB == resource.data.ownerB;
      }
      function overdue() {
        return resource.data.phase == 'drafting' && resource.data.deadline != null && resource.data.deadline <= request.time.toMillis();
      }
      // A new history entry is for the turn now playing and the team acting on it. Only that team's seat may write a
      // manual one; an auto entry needs an overdue deadline, and then either seat may write it.
      function entryOk(e) {
        let r = resource.data;
        return e.keys().hasOnly(['index', 'team', 'action', 'target', 'itemId', 'auto', 'random', 'by'])
          && e.index == r.turnIndex
          && e.team == r.turnTeams[r.turnIndex]
          && ((e.auto == false && ownerOf(e.team) == request.auth.uid) || (e.auto == true && overdue()));
      }
      // Recorded history never changes; it may grow by exactly one legal-looking entry per write.
      function historyOk() {
        let o = resource.data.history;
        let n = request.resource.data.history;
        return n == o || (n.size() == o.size() + 1 && (o.size() == 0 || n[0:o.size()] == o) && entryOk(n[o.size()]));
      }
      // The turn only moves forward, and exactly when a history entry is added.
      function positionOk() {
        let r = resource.data;
        let n = request.resource.data;
        return n.turnIndex >= r.turnIndex
          && n.turnIndex <= r.turnTeams.size()
          && ((n.turnIndex == r.turnIndex) == (n.history.size() == r.history.size()));
      }
      function phaseOk() {
        let r = resource.data.phase;
        let n = request.resource.data.phase;
        return n == r || (r == 'lobby' && n == 'drafting') || (r == 'drafting' && n == 'done');
      }
      // A seat sets only its own confirm flag. The flags reset to false only with a new entry or when the draft starts.
      function confirmOk() {
        let r = resource.data.confirm;
        let n = request.resource.data.confirm;
        let other = resource.data.ownerA == request.auth.uid ? 'B' : 'A';
        return n == r
          || (r != null && n == null && r[other] == true)
          || (r != null && n != null && n[other] == r[other])
          || (n != null && n.keys().hasOnly(['A', 'B']) && n.A == false && n.B == false
              && (request.resource.data.history.size() != resource.data.history.size() || request.resource.data.phase != resource.data.phase));
      }

      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.phase == 'lobby'
        && request.resource.data.turnIndex == 0
        && request.resource.data.history.size() == 0
        && request.resource.data.confirm == null
        && request.resource.data.preset is string
        && request.resource.data.preset.size() < 100000
        && request.resource.data.turnTeams.size() <= 5000;

      allow update: if request.auth != null && (
        // Claim an empty seat in the lobby.
        (
          resource.data.phase == 'lobby' &&
          request.resource.data.phase == 'lobby' &&
          (
            (resource.data.ownerA == null &&
              request.resource.data.ownerA == request.auth.uid &&
              request.resource.data.ownerB == resource.data.ownerB &&
              changed().hasOnly(['ownerA', 'state', 'updatedAt'])) ||
            (resource.data.ownerB == null &&
              request.resource.data.ownerB == request.auth.uid &&
              request.resource.data.ownerA == resource.data.ownerA &&
              changed().hasOnly(['ownerB', 'state', 'updatedAt']))
          )
        ) ||
        // Release your own seat in the lobby.
        (
          resource.data.phase == 'lobby' &&
          request.resource.data.phase == 'lobby' &&
          (
            (resource.data.ownerA == request.auth.uid &&
              request.resource.data.ownerA == null &&
              request.resource.data.ownerB == resource.data.ownerB &&
              changed().hasOnly(['ownerA', 'state', 'updatedAt'])) ||
            (resource.data.ownerB == request.auth.uid &&
              request.resource.data.ownerB == null &&
              request.resource.data.ownerA == resource.data.ownerA &&
              changed().hasOnly(['ownerB', 'state', 'updatedAt']))
          )
        ) ||
        // Seat owners write draft state. Preset, turnTeams and recorded history are fixed; see the helpers above.
        (
          isSeat() &&
          seatsSame() &&
          changed().hasOnly(['state', 'phase', 'deadline', 'turnIndex', 'updatedAt', 'history', 'confirm']) &&
          phaseOk() &&
          positionOk() &&
          historyOk() &&
          confirmOk()
        )
      );

      allow delete: if false;
    }
  }
}
